#!/bin/bash -e

set -o pipefail

EXPECTED_FINGERPRINT=E148DCEBF90919B49C68F056A8C670C86F88B031
SOURCE_RECORD=/usr/local/share/turnkey-zoneminder/source

[ "${1:-}" = --check ] || {
    echo "usage: zoneminder-update --check" >&2
    exit 2
}

apt-get update -qq
installed=$(dpkg-query -W -f='${Version}' zoneminder)
candidate=$(apt-cache policy zoneminder | sed -n 's/^[[:space:]]*Candidate: //p')
fingerprint=$(gpg --batch --show-keys --with-colons /etc/apt/trusted.gpg.d/zmrepo.asc |
    awk -F: '$1 == "fpr" { print $10; exit }')
[ "$fingerprint" = "$EXPECTED_FINGERPRINT" ]
[ -s "$SOURCE_RECORD" ]
case "$candidate" in
    1.38.*) ;;
    *)
        echo "ZoneMinder stable-channel candidate is unavailable or invalid: $candidate" >&2
        exit 1
        ;;
esac

echo "installed=$installed"
echo "candidate=$candidate"
echo "channel=official release-1.38 trixie"
if dpkg --compare-versions "$candidate" eq "$installed"; then
    echo "status=up-to-date"
elif dpkg --compare-versions "$candidate" gt "$installed"; then
    echo "status=update-available"
else
    echo "ZoneMinder stable channel would downgrade $installed to $candidate" >&2
    exit 1
fi
