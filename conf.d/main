#!/bin/bash -ex

ZM_VERSION=1.38.4+trixie1
ZM_PACKAGE_URL=https://zmrepo.zoneminder.com/debian/release-1.38/trixie/zoneminder_1.38.4+trixie1_amd64.deb
ZM_PACKAGE_SHA256=4828e9a0e86e2015701571cc443d37aae5e43fd4e270759c3f28463ae135f12e
ZM_KEY_FINGERPRINT=E148DCEBF90919B49C68F056A8C670C86F88B031

install() {
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get -y \
        -o DPkg::Options::=--force-confdef \
        -o DPkg::Options::=--force-confold \
        install $@
}

# remove unrequired webcp icons (all except those named)
cd /var/www/images
find . -type f ! -name "adminer.png" ! -name "shell.png" ! -name "tab.png" ! -name "webmin.png" -delete

a2enmod cgi
a2enmod rewrite
a2dissite 000-default
a2ensite zoneminder
a2ensite tkl-webcp-zm
service apache2 start

# Temporarily replace systemctl with our wrapper
# since the zoneminder package uses a hardcoded path
# to call it
mv /usr/bin/systemctl /usr/bin/systemctl.orig
ln -s /usr/local/bin/systemctl /usr/bin

# Install the exact verified ZoneMinder package. The retained upstream apt
# repository supplies dependencies and supervised updates.
curl -fsSL "$ZM_PACKAGE_URL" -o /tmp/zoneminder.deb
printf '%s  %s\n' "$ZM_PACKAGE_SHA256" /tmp/zoneminder.deb | sha256sum -c -
install /tmp/zoneminder.deb
[ "$(dpkg-query -W -f='${Version}' zoneminder)" = "$ZM_VERSION" ]
a2enconf zoneminder
rm /usr/bin/systemctl
mv /usr/bin/systemctl.orig /usr/bin/systemctl

service apache2 stop

service mysql start
mysql --batch -e "SELECT 1 FROM zm.Users WHERE Username='admin';"
mysql --batch -e "UPDATE zm.Config SET Value=1 WHERE Name='ZM_OPT_USE_AUTH';"

service mysql stop

#Permissions Editing
chmod 740 /etc/zm/zm.conf
chown root:www-data /etc/zm/zm.conf

#Enable Zoneminder
/usr/bin/systemctl enable zoneminder.service

#Add www-data to video
adduser www-data video

install -d /usr/local/share/turnkey-zoneminder
cat > /usr/local/share/turnkey-zoneminder/source <<EOF
package_source=official ZoneMinder release-1.38 Trixie apt repository
installed_version=$ZM_VERSION
package_url=$ZM_PACKAGE_URL
package_sha256=$ZM_PACKAGE_SHA256
key_fingerprint=$ZM_KEY_FINGERPRINT
repository=https://zmrepo.zoneminder.com/debian/release-1.38 trixie
EOF
